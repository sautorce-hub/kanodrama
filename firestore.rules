rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-:]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'streakCount', 'lastVisitDate', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'streakCount', 'lastVisitDate', 'updatedAt'])
        && data.uid is string
        && data.uid == userId
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 120
        && (!('email' in data) || (data.email is string && data.email.size() <= 180))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && data.streakCount is int
        && data.streakCount >= 1
        && data.streakCount <= 36500
        && data.lastVisitDate is string
        && data.lastVisitDate.size() == 10
        && data.lastVisitDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.updatedAt == request.time;
    }

    function isValidComment(data) {
      return data.keys().hasAll(['authorUid', 'author', 'text', 'createdAt'])
        && data.keys().hasOnly(['authorUid', 'author', 'authorPhotoURL', 'authorBadge', 'text', 'createdAt'])
        && data.authorUid is string
        && data.authorUid == request.auth.uid
        && data.author is string
        && data.author.size() >= 1
        && data.author.size() <= 120
        && (!('authorPhotoURL' in data) || (data.authorPhotoURL is string && data.authorPhotoURL.size() <= 500))
        && (!('authorBadge' in data) || (data.authorBadge is string && data.authorBadge.size() <= 60))
        && data.text is string
        && data.text.size() >= 1
        && data.text.size() <= 240
        && data.createdAt == request.time;
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId}/private/{docId} {
      allow get: if isOwner(userId) && isValidId(userId) && isValidId(docId);
      allow create: if isOwner(userId) && isValidId(userId) && docId == 'profile'
        && isValidUserProfile(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(userId) && docId == 'profile'
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoURL', 'streakCount', 'lastVisitDate', 'updatedAt']);
      allow delete: if false;
    }

    match /episodes/{episodeKey}/comments/{commentId} {
      allow get, list: if isValidId(episodeKey);
      allow create: if isSignedIn() && isValidId(episodeKey) && isValidId(commentId)
        && isValidComment(incoming());
      allow delete: if isSignedIn() && isValidId(episodeKey) && isValidId(commentId)
        && existing().authorUid == request.auth.uid;
      allow update: if false;
    }
  }
}

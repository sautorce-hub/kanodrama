# ==============================================================================
# KanoDrama (kano-drama.xyz) — Environment Configuration
# ==============================================================================
# Catatan: Aturan poin, cooldown, batas harian/mingguan, referral (3.600 detik),
# anti-cheat, dan ambang batas payout (Rp 50.000 / $5.00) sudah memiliki
# nilai default terpusat di `server/config.ts`.
# ==============================================================================

# --- WAJIB DIISI (Produksi & Fitur Penuh) ---
DATABASE_URL=
MOLA_API_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_PAYOUT_SECRET=
STREAM_SIGNING_SECRET=

# --- OPSIONAL (Sudah memiliki nilai default aman di server/config.ts) ---
# Canonical base URL aplikasi (default otomatis mengikuti host / https://kano-drama.xyz)
SITE_URL=https://kano-drama.xyz

# JSON atau Base64 Service Account untuk Google Indexing API (opsional)
GOOGLE_INDEXING_SERVICE_ACCOUNT_JSON=

# Override kurs & minimum payout (opsional; default: 20000 poin=$1 / 100000 poin=$5, kurs 18200 IDR/USD, min Rp 50.000 / $5.00)
POINTS_PER_USD=20000
USD_TO_IDR_RATE=18200
MIN_PAYOUT_IDR=50000
MIN_PAYOUT_USD=5